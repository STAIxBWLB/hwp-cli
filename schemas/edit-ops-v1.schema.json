{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwp-cli.staix.net/schemas/edit-ops-v1.schema.json",
  "title": "hwp-cli EditOps v1",
  "description": "Contract for `hwp edit --ops <file.json>`: a flat, ordered array of typed edit operations, applied in order. Shape-only: exactly-one selectors, paired image sizes, count >= 1, and non-empty strings are enforced by the parser after this schema passes. Compilation also requires document-spec-v1.schema.json registered under its $id (https://hwp-cli.staix.net/schemas/document-spec-v1.schema.json), including batches without insert_blocks. Load both bundled schemas together; the CLI embeds and registers them offline.",
  "type": "array",
  "minItems": 1,
  "maxItems": 10000,
  "items": { "$ref": "#/$defs/editOp" },
  "$defs": {
    "formBinding_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "formBinding_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "formBinding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "formBinding_target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "occurrence_id": {
          "$ref": "#/$defs/formBinding_identifier"
        },
        "copies": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "default": [
            0
          ]
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "allow_reflow": {
          "type": "boolean"
        }
      },
      "required": [
        "occurrence_id",
        "max_chars",
        "allow_reflow"
      ]
    },
    "formBinding_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/formBinding_key"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/formBinding_target"
          }
        }
      },
      "required": [
        "key",
        "targets"
      ]
    },
    "formBinding_repeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "table_id": {
          "$ref": "#/$defs/formBinding_identifier"
        },
        "after_paragraph_id": {
          "$ref": "#/$defs/formBinding_identifier"
        },
        "copies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "profile_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/formBinding_key"
          }
        }
      },
      "required": [
        "table_id",
        "after_paragraph_id",
        "copies",
        "profile_ids"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "copies": {
                "const": 1
              }
            },
            "required": [
              "copies"
            ]
          },
          "then": {
            "properties": {
              "profile_ids": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "copies": {
                "const": 2
              }
            },
            "required": [
              "copies"
            ]
          },
          "then": {
            "properties": {
              "profile_ids": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "copies": {
                "const": 3
              }
            },
            "required": [
              "copies"
            ]
          },
          "then": {
            "properties": {
              "profile_ids": {
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "copies": {
                "const": 4
              }
            },
            "required": [
              "copies"
            ]
          },
          "then": {
            "properties": {
              "profile_ids": {
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "copies": {
                "const": 5
              }
            },
            "required": [
              "copies"
            ]
          },
          "then": {
            "properties": {
              "profile_ids": {
                "minItems": 5,
                "maxItems": 5
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "copies": {
                "const": 6
              }
            },
            "required": [
              "copies"
            ]
          },
          "then": {
            "properties": {
              "profile_ids": {
                "minItems": 6,
                "maxItems": 6
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "copies": {
                "const": 7
              }
            },
            "required": [
              "copies"
            ]
          },
          "then": {
            "properties": {
              "profile_ids": {
                "minItems": 7,
                "maxItems": 7
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "copies": {
                "const": 8
              }
            },
            "required": [
              "copies"
            ]
          },
          "then": {
            "properties": {
              "profile_ids": {
                "minItems": 8,
                "maxItems": 8
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "copies": {
                "const": 9
              }
            },
            "required": [
              "copies"
            ]
          },
          "then": {
            "properties": {
              "profile_ids": {
                "minItems": 9,
                "maxItems": 9
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "copies": {
                "const": 10
              }
            },
            "required": [
              "copies"
            ]
          },
          "then": {
            "properties": {
              "profile_ids": {
                "minItems": 10,
                "maxItems": 10
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "copies": {
                "const": 11
              }
            },
            "required": [
              "copies"
            ]
          },
          "then": {
            "properties": {
              "profile_ids": {
                "minItems": 11,
                "maxItems": 11
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "copies": {
                "const": 12
              }
            },
            "required": [
              "copies"
            ]
          },
          "then": {
            "properties": {
              "profile_ids": {
                "minItems": 12,
                "maxItems": 12
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "copies": {
                "const": 13
              }
            },
            "required": [
              "copies"
            ]
          },
          "then": {
            "properties": {
              "profile_ids": {
                "minItems": 13,
                "maxItems": 13
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "copies": {
                "const": 14
              }
            },
            "required": [
              "copies"
            ]
          },
          "then": {
            "properties": {
              "profile_ids": {
                "minItems": 14,
                "maxItems": 14
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "copies": {
                "const": 15
              }
            },
            "required": [
              "copies"
            ]
          },
          "then": {
            "properties": {
              "profile_ids": {
                "minItems": 15,
                "maxItems": 15
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "copies": {
                "const": 16
              }
            },
            "required": [
              "copies"
            ]
          },
          "then": {
            "properties": {
              "profile_ids": {
                "minItems": 16,
                "maxItems": 16
              }
            }
          }
        }
      ]
    },
    "formBinding_constraint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "equal"
            },
            "left": {
              "$ref": "#/$defs/formBinding_key"
            },
            "right": {
              "$ref": "#/$defs/formBinding_key"
            }
          },
          "required": [
            "kind",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "sum"
            },
            "keys": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/formBinding_key"
              }
            },
            "total": {
              "$ref": "#/$defs/formBinding_key"
            }
          },
          "required": [
            "kind",
            "keys",
            "total"
          ]
        }
      ]
    },
    "formBinding_values": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/formBinding_key"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 20000,
        "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F]*$"
      },
      "description": "Literal values. LF and TAB are allowed; other C0 controls, including CR, are forbidden. Runtime requires exactly the binding keys and validates numeric rules."
    },
    "formBindingPlan": {
      "title": "hwp-cli FormBindingPlan v1",
      "description": "Source-bound reviewed form bindings. Keys are literal and are never normalized. Runtime additionally checks unique binding keys and unique (occurrence_id, copy) ownership, exact values-key membership, integer constraints and source/catalogue identity. Equal is numeric equality; constraints accept only unsigned ASCII integer strings, optionally with correctly grouped comma thousands, within i64::MAX. No expression evaluator. Profile copy counts include the original. This schema defines plan data, not native-open or layout evidence.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/formBinding_sha256"
        },
        "structural_sha256": {
          "$ref": "#/$defs/formBinding_sha256"
        },
        "bindings": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/formBinding_binding"
          }
        },
        "repeats": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/formBinding_repeat"
          },
          "default": []
        },
        "constraints": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/formBinding_constraint"
          },
          "default": []
        }
      },
      "required": [
        "version",
        "source_sha256",
        "structural_sha256",
        "bindings"
      ]
    },
    "unit": { "type": "string", "pattern": "^\\d+(\\.\\d+)?(mm|pt|%)$" },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "switch": { "type": "string", "enum": ["on", "off"] },
    "fontName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "description": "A font face name (A2): written uniformly into all seven language slots via find-or-insert against the document's font table (find_or_insert_face). Non-empty; control characters are rejected (T-07-17)."
    },
    "align": {
      "type": "string",
      "description": "Case-sensitive: exact lowercase English tokens or Korean aliases only, unlike the --set-align CLI flag and MCP hwp_edit tool (both case-insensitive). This ops-file channel is a typed machine contract, so values are validated exactly as listed.",
      "enum": [
        "left",
        "right",
        "center",
        "justify",
        "both",
        "distribute",
        "divide",
        "왼쪽",
        "오른쪽",
        "가운데",
        "양쪽",
        "배분",
        "나눔"
      ]
    },
    "orientation": {
      "type": "string",
      "description": "Case-sensitive: exact lowercase English tokens or Korean aliases only, unlike the --set-page CLI flag and MCP hwp_edit tool (both case-insensitive). This ops-file channel is a typed machine contract, so values are validated exactly as listed.",
      "enum": ["portrait", "landscape", "가로", "세로"]
    },
    "preset": {
      "type": "string",
      "description": "Case-sensitive: exact lowercase English tokens or Korean aliases only, unlike the --style-tables CLI flag and MCP hwp_edit tool (both case-insensitive via OfficialPreset::parse). This ops-file channel is a typed machine contract, so values are validated exactly as listed.",
      "enum": [
        "official",
        "gian",
        "gongmun",
        "report",
        "bogoseo",
        "plan",
        "notice",
        "minutes",
        "press",
        "기안",
        "기안문",
        "공문",
        "공문서",
        "보고",
        "보고서",
        "계획",
        "계획서",
        "사업계획",
        "사업계획서",
        "공고",
        "공고문",
        "고시",
        "회의록",
        "회의기록",
        "보도",
        "보도자료"
      ]
    },
    "u16": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "usize": { "type": "integer", "minimum": 0 },
    "segmentId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}(\\.[0-9]+){1,32}$",
      "description": "A segment id: a 16-hex-character checksum (segment_id.rs's checksum width) followed by 1 to 32 dot-separated positional indices (section, then the nesting chain down to the paragraph, with a trailing run index appended for a run-granularity address — the same shape segment_id.rs::run_id emits)."
    },
    "addressPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "paragraph"],
      "description": "A raw positional address naming a TOP-LEVEL paragraph only ({\"section\":0,\"paragraph\":3} means doc.sections[0].paragraphs[3]). A paragraph nested inside a table cell or a generic control has no `at` spelling; it is addressed by `id`, whose path already carries the full index chain.",
      "properties": {
        "section": { "$ref": "#/$defs/u16" },
        "paragraph": { "type": "integer", "minimum": 0, "maximum": 1048575 },
        "run": { "$ref": "#/$defs/u16" }
      }
    },
    "charRange": {
      "type": "array",
      "description": "A [start, end) WCHAR sub-range, in UTF-16 code units absolute within the source paragraph (A1) — the same coordinate space `restyle_range` already takes, matching render-layout-v1's source_chars and document_split.rs's ParagraphAddress.wchar_offset. This is a DIFFERENT coordinate space from segment-envelope-v2's char_range (Unicode scalars into the rendered markdown); nothing converts between them, so a caller holding a char_range from `hwp cat --segments v2` must convert before composing this field.",
      "items": { "type": "integer", "minimum": 0, "maximum": 1048575 },
      "minItems": 2,
      "maxItems": 2
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "description": "A target address: exactly one of id (a checksummed segment id, drift-checked at apply time) or at (a raw positional path, no drift check). chars optionally narrows to a WCHAR sub-range; see paragraphAddress/runAddress for the per-op granularity rules (D-11).",
      "properties": {
        "id": { "$ref": "#/$defs/segmentId" },
        "at": { "$ref": "#/$defs/addressPath" },
        "chars": { "$ref": "#/$defs/charRange" }
      },
      "oneOf": [{ "required": ["id"] }, { "required": ["at"] }]
    },
    "paragraphAddress": {
      "allOf": [
        { "$ref": "#/$defs/address" },
        { "not": { "required": ["chars"] } },
        {
          "if": { "required": ["at"] },
          "then": { "properties": { "at": { "not": { "required": ["run"] } } } }
        }
      ],
      "description": "An address restricted to paragraph granularity: chars and at.run are forbidden — a paragraph-level op rejects a run-range address as a schema violation rather than ignoring the extra depth (D-11)."
    },
    "runAddress": {
      "$ref": "#/$defs/address",
      "description": "An address at run granularity. chars is OPTIONAL: an address naming a run with no chars applies to the whole run (D-01) — the id/at identifies the run, not a range. chars narrows the op to a WCHAR sub-range of that run when given."
    },
    "paraPropsFields": {
      "type": "object",
      "properties": {
        "line_spacing_pct": { "$ref": "#/$defs/unit" },
        "line_spacing_pt": { "$ref": "#/$defs/unit" },
        "indent_mm": { "$ref": "#/$defs/unit" },
        "left_mm": { "$ref": "#/$defs/unit" },
        "right_mm": { "$ref": "#/$defs/unit" },
        "top_mm": { "$ref": "#/$defs/unit" },
        "bottom_mm": { "$ref": "#/$defs/unit" },
        "align": { "$ref": "#/$defs/align" }
      },
      "description": "Shared paragraph-shape property fields (D-08): flat on create_style/update_style/set_para/set_cell_para via allOf+unevaluatedProperties, and nested as insert_para's own style object. One spelling per concept — line_spacing_pct and line_spacing_pt stay mutually exclusive (parser-enforced)."
    },
    "charPropsFields": {
      "type": "object",
      "properties": {
        "bold": { "$ref": "#/$defs/switch" },
        "italic": { "$ref": "#/$defs/switch" },
        "underline": { "$ref": "#/$defs/switch" },
        "strike": { "$ref": "#/$defs/switch" },
        "size": { "$ref": "#/$defs/unit" },
        "color": { "$ref": "#/$defs/color" },
        "font": { "$ref": "#/$defs/fontName" }
      },
      "description": "Shared character-format property fields (D-08): flat on create_style/update_style/set_format via allOf+unevaluatedProperties, and nested as insert_para's own char object. One spelling per concept."
    },
    "styleName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65535,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "description": "A primary named-style name. Native UTF-16 length and control-character constraints are checked by the style editor."
    },
    "styleRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/styleName"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      ],
      "description": "An exact primary style name or explicit header style id; no string-to-number coercion."
    },
    "editOp": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "plan",
            "values",
            "receipt"
          ],
          "properties": {
            "op": {
              "const": "apply_form_bindings"
            },
            "plan": {
              "$ref": "#/$defs/formBindingPlan"
            },
            "values": {
              "$ref": "#/$defs/formBinding_values"
            },
            "receipt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "preview": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "description": "Exclusive compound binding operation. Receipt is content-free; preview is explicitly requested local document content. Cannot be combined with another operation."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "address", "position", "blocks"],
          "properties": {
            "op": { "const": "insert_blocks" },
            "address": { "$ref": "#/$defs/paragraphAddress" },
            "position": { "enum": ["before", "after"] },
            "missing_style": { "enum": ["create", "refuse"], "default": "create" },
            "styles": { "$ref": "https://hwp-cli.staix.net/schemas/document-spec-v1.schema.json#/properties/styles" },
            "lists": { "$ref": "https://hwp-cli.staix.net/schemas/document-spec-v1.schema.json#/properties/lists" },
            "blocks": {
              "type": "array", "minItems": 1, "maxItems": 20000,
              "items": { "$ref": "https://hwp-cli.staix.net/schemas/document-spec-v1.schema.json#/$defs/block" }
            }
          }
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "op",
            "name",
            "kind"
          ],
          "description": "Create a named style from based_on (default style id 0), using the existing flat property vocabulary. Duplicate names and unresolved bases are refused. T3 supports paragraph kinds only; character requests receive an actionable runtime refusal pending the character-style follow-up after PR #442.",
          "allOf": [
            {
              "$ref": "#/$defs/charPropsFields"
            },
            {
              "$ref": "#/$defs/paraPropsFields"
            },
            {
              "properties": {
                "op": {
                  "const": "create_style"
                },
                "name": {
                  "$ref": "#/$defs/styleName"
                },
                "based_on": {
                  "$ref": "#/$defs/styleRef"
                },
                "kind": {
                  "enum": [
                    "paragraph",
                    "character"
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": ["op", "style"],
          "description": "Update a named paragraph style using fresh changed shape IDs. Paragraph and run inheritance follow independently; direct references and old shared definitions stay unchanged. Empty or unchanged updates add no definitions.",
          "allOf": [
            { "$ref": "#/$defs/charPropsFields" },
            { "$ref": "#/$defs/paraPropsFields" },
            {
              "properties": {
                "op": { "const": "update_style" },
                "style": { "$ref": "#/$defs/styleRef" }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "address",
            "style"
          ],
          "description": "Apply a named paragraph style. Addresses resolve against the original document. Inherited character and paragraph shapes follow independently; clear_direct defaults to false.",
          "properties": {
            "op": {
              "const": "apply_style"
            },
            "address": {
              "$ref": "#/$defs/paragraphAddress"
            },
            "style": {
              "$ref": "#/$defs/styleRef"
            },
            "clear_direct": {
              "type": "boolean",
              "default": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "from", "to"],
          "description": "address optionally narrows the from/to match-and-replace from the whole document (default) to inside one paragraph (D-12); from is required either way, unlike pattern on set_para/set_align, since it is always the matched substring, never purely a selector.",
          "properties": {
            "op": { "const": "replace" },
            "from": { "type": "string" },
            "address": {
              "$ref": "#/$defs/paragraphAddress",
              "description": "Paragraph granularity — a run-range address here is a schema violation (D-11). Narrows from/to matching to inside the addressed paragraph only."
            },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "table", "row", "col", "text"],
          "properties": {
            "op": { "const": "set_cell" },
            "table": { "$ref": "#/$defs/usize" },
