{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwp-cli.dev/schemas/edit-ops-v1.schema.json",
  "title": "hwp-cli EditOps v1",
  "description": "Contract for `hwp edit --ops <file.json>`: a flat, ordered array of typed edit operations, applied in order. Shape-only: exactly-one selectors, paired image sizes, count >= 1, and non-empty strings are enforced by the parser after this schema passes.",
  "type": "array",
  "minItems": 1,
  "maxItems": 10000,
  "items": { "$ref": "#/$defs/editOp" },
  "$defs": {
    "unit": { "type": "string", "pattern": "^\\d+(\\.\\d+)?(mm|pt|%)$" },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "switch": { "type": "string", "enum": ["on", "off"] },
    "fontName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "description": "A font face name (A2): written uniformly into all seven language slots via find-or-insert against the document's font table (find_or_insert_face). Non-empty; control characters are rejected (T-07-17)."
    },
    "align": {
      "type": "string",
      "description": "Case-sensitive: exact lowercase English tokens or Korean aliases only, unlike the --set-align CLI flag and MCP hwp_edit tool (both case-insensitive). This ops-file channel is a typed machine contract, so values are validated exactly as listed.",
      "enum": [
        "left",
        "right",
        "center",
        "justify",
        "both",
        "distribute",
        "divide",
        "왼쪽",
        "오른쪽",
        "가운데",
        "양쪽",
        "배분",
        "나눔"
      ]
    },
    "orientation": {
      "type": "string",
      "description": "Case-sensitive: exact lowercase English tokens or Korean aliases only, unlike the --set-page CLI flag and MCP hwp_edit tool (both case-insensitive). This ops-file channel is a typed machine contract, so values are validated exactly as listed.",
      "enum": ["portrait", "landscape", "가로", "세로"]
    },
    "preset": {
      "type": "string",
      "description": "Case-sensitive: exact lowercase English tokens or Korean aliases only, unlike the --style-tables CLI flag and MCP hwp_edit tool (both case-insensitive via OfficialPreset::parse). This ops-file channel is a typed machine contract, so values are validated exactly as listed.",
      "enum": [
        "official",
        "gian",
        "gongmun",
        "report",
        "bogoseo",
        "plan",
        "notice",
        "minutes",
        "press",
        "기안",
        "기안문",
        "공문",
        "공문서",
        "보고",
        "보고서",
        "계획",
        "계획서",
        "사업계획",
        "사업계획서",
        "공고",
        "공고문",
        "고시",
        "회의록",
        "회의기록",
        "보도",
        "보도자료"
      ]
    },
    "u16": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "usize": { "type": "integer", "minimum": 0 },
    "segmentId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}(\\.[0-9]+){1,32}$",
      "description": "A segment id: a 16-hex-character checksum (segment_id.rs's checksum width) followed by 1 to 32 dot-separated positional indices (section, then the nesting chain down to the paragraph, with a trailing run index appended for a run-granularity address — the same shape segment_id.rs::run_id emits)."
    },
    "addressPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "paragraph"],
      "description": "A raw positional address naming a TOP-LEVEL paragraph only ({\"section\":0,\"paragraph\":3} means doc.sections[0].paragraphs[3]). A paragraph nested inside a table cell or a generic control has no `at` spelling; it is addressed by `id`, whose path already carries the full index chain.",
      "properties": {
        "section": { "$ref": "#/$defs/u16" },
        "paragraph": { "type": "integer", "minimum": 0, "maximum": 1048575 },
        "run": { "$ref": "#/$defs/u16" }
      }
    },
    "charRange": {
      "type": "array",
      "description": "A [start, end) WCHAR sub-range, in UTF-16 code units absolute within the source paragraph (A1) — the same coordinate space `restyle_range` already takes, matching render-layout-v1's source_chars and document_split.rs's ParagraphAddress.wchar_offset. This is a DIFFERENT coordinate space from segment-envelope-v2's char_range (Unicode scalars into the rendered markdown); nothing converts between them, so a caller holding a char_range from `hwp cat --segments v2` must convert before composing this field.",
      "items": { "type": "integer", "minimum": 0, "maximum": 1048575 },
      "minItems": 2,
      "maxItems": 2
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "description": "A target address: exactly one of id (a checksummed segment id, drift-checked at apply time) or at (a raw positional path, no drift check). chars optionally narrows to a WCHAR sub-range; see paragraphAddress/runAddress for the per-op granularity rules (D-11).",
      "properties": {
        "id": { "$ref": "#/$defs/segmentId" },
        "at": { "$ref": "#/$defs/addressPath" },
        "chars": { "$ref": "#/$defs/charRange" }
      },
      "oneOf": [{ "required": ["id"] }, { "required": ["at"] }]
    },
    "paragraphAddress": {
      "allOf": [
        { "$ref": "#/$defs/address" },
        { "not": { "required": ["chars"] } },
        {
          "if": { "required": ["at"] },
          "then": { "properties": { "at": { "not": { "required": ["run"] } } } }
        }
      ],
      "description": "An address restricted to paragraph granularity: chars and at.run are forbidden — a paragraph-level op rejects a run-range address as a schema violation rather than ignoring the extra depth (D-11)."
    },
    "runAddress": {
      "$ref": "#/$defs/address",
      "description": "An address at run granularity. chars is OPTIONAL: an address naming a run with no chars applies to the whole run (D-01) — the id/at identifies the run, not a range. chars narrows the op to a WCHAR sub-range of that run when given."
    },
    "paraPropsFields": {
      "type": "object",
      "properties": {
        "line_spacing_pct": { "$ref": "#/$defs/unit" },
        "line_spacing_pt": { "$ref": "#/$defs/unit" },
        "indent_mm": { "$ref": "#/$defs/unit" },
        "left_mm": { "$ref": "#/$defs/unit" },
        "right_mm": { "$ref": "#/$defs/unit" },
        "top_mm": { "$ref": "#/$defs/unit" },
        "bottom_mm": { "$ref": "#/$defs/unit" },
        "align": { "$ref": "#/$defs/align" }
      },
      "description": "Shared paragraph-shape property fields (D-08): flat on set_para/set_cell_para via allOf+unevaluatedProperties, and nested as insert_para's own style object. One spelling per concept — line_spacing_pct and line_spacing_pt stay mutually exclusive (parser-enforced)."
    },
    "charPropsFields": {
      "type": "object",
      "properties": {
        "bold": { "$ref": "#/$defs/switch" },
        "italic": { "$ref": "#/$defs/switch" },
        "underline": { "$ref": "#/$defs/switch" },
        "strike": { "$ref": "#/$defs/switch" },
        "size": { "$ref": "#/$defs/unit" },
        "color": { "$ref": "#/$defs/color" },
        "font": { "$ref": "#/$defs/fontName" }
      },
      "description": "Shared character-format property fields (D-08): flat on set_format via allOf+unevaluatedProperties, and nested as insert_para's own char object. One spelling per concept."
    },
    "editOp": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "from", "to"],
          "description": "address optionally narrows the from/to match-and-replace from the whole document (default) to inside one paragraph (D-12); from is required either way, unlike pattern on set_para/set_align, since it is always the matched substring, never purely a selector.",
          "properties": {
            "op": { "const": "replace" },
            "from": { "type": "string" },
            "address": {
              "$ref": "#/$defs/paragraphAddress",
              "description": "Paragraph granularity — a run-range address here is a schema violation (D-11). Narrows from/to matching to inside the addressed paragraph only."
            },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "table", "row", "col", "text"],
          "properties": {
            "op": { "const": "set_cell" },
            "table": { "$ref": "#/$defs/usize" },
            "row": { "$ref": "#/$defs/u16" },
            "col": { "$ref": "#/$defs/u16" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "label", "text"],
          "properties": {
            "op": { "const": "set_cell_by_label" },
            "label": { "type": "string" },
            "text": { "type": "string" },
            "table": { "$ref": "#/$defs/usize" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "anchor", "name"],
          "properties": {
            "op": { "const": "create_field" },
            "anchor": { "type": "string" },
            "name": { "type": "string" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "anchor", "name"],
          "properties": {
            "op": { "const": "create_bookmark" },
            "anchor": { "type": "string" },
            "name": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "anchor", "url"],
          "properties": {
            "op": { "const": "create_hyperlink" },
            "anchor": { "type": "string" },
            "display": { "type": "string" },
            "url": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "anchor", "path"],
          "description": "width_mm and height_mm are individually optional but must be given together (parser-enforced).",
          "properties": {
            "op": { "const": "insert_image" },
            "anchor": { "type": "string" },
            "path": { "type": "string" },
            "width_mm": { "$ref": "#/$defs/unit" },
            "height_mm": { "$ref": "#/$defs/unit" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "anchor", "path"],
          "properties": {
            "op": { "const": "seal" },
            "anchor": { "type": "string" },
            "path": { "type": "string" },
            "size_mm": { "$ref": "#/$defs/unit" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "name", "value"],
          "properties": {
            "op": { "const": "set_field" },
            "name": { "type": "string" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "key", "value"],
          "properties": {
            "op": { "const": "set_meta" },
            "key": { "type": "string" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": ["op"],
          "description": "Exactly one of pattern (anchor-text selector) or address (id/at selector, D-12) is required (parser-enforced). Char-format props are flat on the entry via the shared charPropsFields definition (D-08).",
          "allOf": [
            { "$ref": "#/$defs/charPropsFields" },
            {
              "properties": {
                "op": { "const": "set_format" },
                "pattern": { "type": "string" },
                "address": { "$ref": "#/$defs/runAddress" }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "align"],
          "description": "Exactly one of pattern (anchor-text selector) or address (paragraph granularity, D-12) is required (parser-enforced).",
          "properties": {
            "op": { "const": "set_align" },
            "pattern": { "type": "string" },
            "address": {
              "$ref": "#/$defs/paragraphAddress",
              "description": "Paragraph granularity — a run-range address here is a schema violation (D-11)."
            },
            "align": { "$ref": "#/$defs/align" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "text"],
          "description": "Exactly one of anchor (text-anchor selector) or address (paragraph granularity, D-12) is required (parser-enforced). style/char optionally set the new paragraph's own properties inline (D-08), reusing paraPropsFields/charPropsFields — a later op can never address content this one just created (D-06), so a creating op carries its own properties instead of a follow-up style op.",
          "properties": {
            "op": { "const": "insert_para" },
            "anchor": { "type": "string" },
            "address": {
              "$ref": "#/$defs/paragraphAddress",
              "description": "Paragraph granularity — a run-range address here is a schema violation (D-11)."
            },
            "text": { "type": "string" },
            "before": { "type": "boolean" },
            "style": { "$ref": "#/$defs/paraPropsFields" },
            "char": { "$ref": "#/$defs/charPropsFields" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op"],
          "description": "Exactly one of matching (anchor-text selector) or address (paragraph granularity, D-12) is required (parser-enforced).",
          "properties": {
            "op": { "const": "delete_para" },
            "matching": { "type": "string" },
            "address": {
              "$ref": "#/$defs/paragraphAddress",
              "description": "Paragraph granularity — a run-range address here is a schema violation (D-11)."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "address", "to"],
          "description": "Moves the paragraph at address to a position relative to the paragraph named in to (D-17: source and destination must name the same section — a cross-section destination is rejected during preflight with a named error, not attempted).",
          "properties": {
            "op": { "const": "move_para" },
            "address": { "$ref": "#/$defs/paragraphAddress" },
            "to": {
              "type": "object",
              "additionalProperties": false,
              "required": ["address", "position"],
              "properties": {
                "address": { "$ref": "#/$defs/paragraphAddress" },
                "position": { "type": "string", "enum": ["before", "after"] }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "table"],
          "properties": {
            "op": { "const": "add_row" },
            "table": { "$ref": "#/$defs/usize" },
            "at": { "$ref": "#/$defs/u16" },
            "count": { "$ref": "#/$defs/usize" },
            "template_row": { "$ref": "#/$defs/u16" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "table"],
          "properties": {
            "op": { "const": "add_col" },
            "table": { "$ref": "#/$defs/usize" },
            "at": { "$ref": "#/$defs/u16" },
            "count": { "$ref": "#/$defs/u16" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "table", "row"],
          "properties": {
            "op": { "const": "delete_row" },
            "table": { "$ref": "#/$defs/usize" },
            "row": { "$ref": "#/$defs/u16" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "table", "col"],
          "properties": {
            "op": { "const": "delete_col" },
            "table": { "$ref": "#/$defs/usize" },
            "col": { "$ref": "#/$defs/u16" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "table", "r1", "c1", "r2", "c2"],
          "properties": {
            "op": { "const": "merge_cells" },
            "table": { "$ref": "#/$defs/usize" },
            "r1": { "$ref": "#/$defs/u16" },
            "c1": { "$ref": "#/$defs/u16" },
            "r2": { "$ref": "#/$defs/u16" },
            "c2": { "$ref": "#/$defs/u16" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "table", "row", "col"],
          "properties": {
            "op": { "const": "split_cell" },
            "table": { "$ref": "#/$defs/usize" },
            "row": { "$ref": "#/$defs/u16" },
            "col": { "$ref": "#/$defs/u16" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "anchor", "rows"],
          "properties": {
            "op": { "const": "add_table" },
            "anchor": { "type": "string" },
            "rows": {
              "type": "array",
              "items": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "source_table", "anchor"],
          "properties": {
            "op": { "const": "clone_table" },
            "source_table": { "$ref": "#/$defs/usize" },
            "anchor": { "type": "string" },
            "text_mode": { "type": "string", "enum": ["blank", "keep"] }
          }
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": ["op"],
          "description": "Exactly one of pattern (anchor-text selector) or address (paragraph granularity, D-12) is required (parser-enforced). Paragraph props are flat on the entry via the shared paraPropsFields definition (D-08); line_spacing_pct and line_spacing_pt are mutually exclusive (parser-enforced).",
          "allOf": [
            { "$ref": "#/$defs/paraPropsFields" },
            {
              "properties": {
                "op": { "const": "set_para" },
                "pattern": { "type": "string" },
                "address": {
                  "$ref": "#/$defs/paragraphAddress",
                  "description": "Paragraph granularity — a run-range address here is a schema violation (D-11)."
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": ["op", "table", "row", "col"],
          "description": "Paragraph props are flat on the entry via the shared paraPropsFields definition (D-08); line_spacing_pct and line_spacing_pt are mutually exclusive (parser-enforced).",
          "allOf": [
            { "$ref": "#/$defs/paraPropsFields" },
            {
              "properties": {
                "op": { "const": "set_cell_para" },
                "table": { "$ref": "#/$defs/usize" },
                "row": { "$ref": "#/$defs/u16" },
                "col": { "$ref": "#/$defs/u16" }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op"],
          "description": "Single page-setup object; all keys optional and merged into one PageProps.",
          "properties": {
            "op": { "const": "set_page" },
            "width_mm": { "$ref": "#/$defs/unit" },
            "height_mm": { "$ref": "#/$defs/unit" },
            "margin_left_mm": { "$ref": "#/$defs/unit" },
            "margin_right_mm": { "$ref": "#/$defs/unit" },
            "margin_top_mm": { "$ref": "#/$defs/unit" },
            "margin_bottom_mm": { "$ref": "#/$defs/unit" },
            "orientation": { "$ref": "#/$defs/orientation" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "anchor"],
          "properties": {
            "op": { "const": "delete_image" },
            "anchor": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op"],
          "description": "Exactly one of index or anchor (parser-enforced).",
          "properties": {
            "op": { "const": "delete_table" },
            "index": { "$ref": "#/$defs/usize" },
            "anchor": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "name"],
          "properties": {
            "op": { "const": "delete_field" },
            "name": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "name"],
          "properties": {
            "op": { "const": "delete_bookmark" },
            "name": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "preset"],
          "properties": {
            "op": { "const": "style_tables" },
            "preset": { "$ref": "#/$defs/preset" }
          }
        }
      ]
    }
  }
}
