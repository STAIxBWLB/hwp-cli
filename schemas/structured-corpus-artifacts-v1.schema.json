{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwp-cli.local/schemas/structured-corpus-artifacts-v1.schema.json",
  "title": "hwp structured corpus artifact manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "file_count", "total_bytes", "files"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "contract": { "const": "hwp-structured-corpus-artifacts-v1" },
    "file_count": { "type": "integer", "minimum": 1, "maximum": 255 },
    "total_bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 255,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?:certification|documents)/[a-z0-9][a-z0-9/-]*\\.(?:json|png|hwp|hwpx)$|^summary\\.json$"
          },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 134217728 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
