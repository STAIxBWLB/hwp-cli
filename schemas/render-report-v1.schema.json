{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwp-cli.dev/schemas/render-report-v1.schema.json",
  "title": "hwp-render-report-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "input",
    "format",
    "dpi",
    "total_pages",
    "selected_pages",
    "font_coverage",
    "issues",
    "info",
    "issue_count",
    "info_count",
    "issue_log_complete",
    "issue_sha256",
    "complete"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "contract": { "const": "hwp-render-report-v1" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "bytes", "sha256"],
      "properties": {
        "format": { "enum": ["hwp5", "hwpx", "unknown"] },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "format": { "enum": ["png", "svg", "pdf"] },
    "dpi": { "type": "number", "minimum": 36, "maximum": 600 },
    "total_pages": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "selected_pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 4096 }
    },
    "font_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matched", "substituted", "missing", "subset_fallback", "substitution_free"],
      "properties": {
        "matched": { "type": "integer", "minimum": 0 },
        "substituted": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "subset_fallback": { "type": "integer", "minimum": 0 },
        "substitution_free": { "type": "boolean" }
      }
    },
    "issues": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/renderIssueNonInfo" },
      "uniqueItems": true
    },
    "info": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/renderIssueInfo" },
      "uniqueItems": true
    },
    "issue_count": { "type": "integer", "minimum": 0 },
    "info_count": { "type": "integer", "minimum": 0 },
    "issue_log_complete": { "type": "boolean" },
    "issue_sha256": { "$ref": "#/$defs/sha256" },
    "complete": { "type": "boolean" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "renderIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "stage", "count", "sample_sha256", "samples_complete"],
      "properties": {
        "code": {
          "enum": [
            "parse_budget_exceeded",
            "render_execution_failed",
            "pagination_drift_detected",
            "font_matched",
            "font_substituted",
            "font_missing",
            "font_manifest_load_failed",
            "font_resolution_budget_exceeded",
            "shaping_failed",
            "page_definition_fallback",
            "page_control_payload_omitted",
            "page_number_format_fallback",
            "page_number_position_omitted",
            "page_number_shaping_omitted",
            "unsupported_control_omitted",
            "image_size_missing_omitted",
            "image_data_missing_omitted",
            "image_decode_placeholder",
            "image_decode_budget_exceeded",
            "picture_effects_unsupported",
            "invalid_table_cell_omitted",
            "table_split_across_pages",
            "table_cell_fragmentation_incomplete",
            "table_row_too_tall_clipped",
            "text_box_geometry_invalid_omitted",
            "shape_depth_limit_omitted",
            "shape_style_invalid_omitted",
            "shape_geometry_invalid_omitted",
            "font_subset_fallback",
            "layout_budget_exceeded"
          ]
        },
        "severity": { "enum": ["info", "warning", "incomplete", "fatal"] },
        "stage": { "enum": ["input_parse", "font_resolution", "layout", "shaping", "rasterization", "pdf_export"] },
        "count": { "type": "integer", "minimum": 1 },
        "sample_sha256": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "samples_complete": { "type": "boolean" }
      },
      "oneOf": [
        { "properties": { "code": { "const": "parse_budget_exceeded" }, "severity": { "const": "fatal" }, "stage": { "const": "input_parse" } } },
        { "properties": { "code": { "enum": ["render_execution_failed", "pagination_drift_detected", "layout_budget_exceeded"] }, "severity": { "const": "fatal" }, "stage": { "const": "layout" } } },
        { "properties": { "code": { "const": "font_matched" }, "severity": { "const": "info" }, "stage": { "const": "font_resolution" } } },
        { "properties": { "code": { "const": "table_split_across_pages" }, "severity": { "const": "info" }, "stage": { "const": "layout" } } },
        { "properties": { "code": { "const": "font_substituted" }, "severity": { "const": "warning" }, "stage": { "const": "font_resolution" } } },
        { "properties": { "code": { "const": "font_missing" }, "severity": { "const": "incomplete" }, "stage": { "const": "font_resolution" } } },
        { "properties": { "code": { "const": "font_manifest_load_failed" }, "severity": { "const": "fatal" }, "stage": { "const": "font_resolution" } } },
        { "properties": { "code": { "const": "font_resolution_budget_exceeded" }, "severity": { "const": "fatal" }, "stage": { "const": "font_resolution" } } },
        { "properties": { "code": { "enum": ["shaping_failed", "page_number_shaping_omitted"] }, "severity": { "const": "incomplete" }, "stage": { "const": "shaping" } } },
        { "properties": { "code": { "enum": ["page_definition_fallback", "page_control_payload_omitted", "page_number_format_fallback", "page_number_position_omitted", "unsupported_control_omitted", "image_size_missing_omitted", "image_data_missing_omitted", "invalid_table_cell_omitted", "table_cell_fragmentation_incomplete", "table_row_too_tall_clipped", "text_box_geometry_invalid_omitted", "shape_depth_limit_omitted", "shape_style_invalid_omitted", "shape_geometry_invalid_omitted"] }, "severity": { "const": "incomplete" }, "stage": { "const": "layout" } } },
        { "properties": { "code": { "const": "image_decode_placeholder" }, "severity": { "const": "incomplete" }, "stage": { "const": "rasterization" } } },
        { "properties": { "code": { "const": "picture_effects_unsupported" }, "severity": { "const": "warning" }, "stage": { "const": "layout" } } },
        { "properties": { "code": { "const": "image_decode_budget_exceeded" }, "severity": { "const": "fatal" }, "stage": { "const": "rasterization" } } },
        { "properties": { "code": { "const": "font_subset_fallback" }, "severity": { "const": "warning" }, "stage": { "const": "pdf_export" } } }
      ]
    },
    "renderIssueNonInfo": {
      "allOf": [
        { "$ref": "#/$defs/renderIssue" },
        { "properties": { "severity": { "enum": ["warning", "incomplete", "fatal"] } } }
      ]
    },
    "renderIssueInfo": {
      "allOf": [
        { "$ref": "#/$defs/renderIssue" },
        { "properties": { "severity": { "const": "info" } } }
      ]
    }
  }
}
