{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halla.ai/schemas/password-corpus-manifest-v1.schema.json",
  "title": "password-corpus-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fixtures"],
  "properties": {
    "version": {
      "const": "password-corpus-manifest-v1"
    },
    "fixtures": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "source_path",
        "format",
        "role",
        "credential_charset",
        "credential_ref"
      ],
      "properties": {
        "fixture_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
        },
        "source_path": {
          "type": "string",
          "pattern": "^/"
        },
        "format": {
          "enum": ["hwp5", "hwpx"]
        },
        "role": {
          "enum": ["baseline", "non_ascii_success"]
        },
        "credential_charset": {
          "enum": ["ascii", "non_ascii"]
        },
        "credential_ref": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    }
  }
}
