{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwp-cli.staix.net/schemas/form-binding-preview-v1.schema.json",
  "title": "hwp-cli Form Binding Preview v1",
  "description": "Explicit local review artifact containing exact original and replacement text plus model addresses. Not a public receipt. Copies count includes the original; claims are half-open Paragraph.chars indices. This is a semantic preview, not render/font/Hancom evidence.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "values_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "copies": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_table_id": {
            "type": "string"
          },
          "copy": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "profile_id": {
            "type": "string"
          },
          "table_id": {
            "type": "string"
          },
          "section": {
            "type": "integer",
            "minimum": 0
          },
          "indices": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "source_table_id",
          "copy",
          "profile_id",
          "table_id",
          "section",
          "indices"
        ]
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "occurrence_id": {
            "type": "string",
            "pattern": "^occ-[0-9a-f]{64}$"
          },
          "copy": {
            "type": "integer",
            "minimum": 0
          },
          "profile_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "paragraph_id": {
            "type": "string"
          },
          "section": {
            "type": "integer",
            "minimum": 0
          },
          "indices": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "row": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "col": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "old_text": {
            "type": "string"
          },
          "new_text": {
            "type": "string",
            "maxLength": 20000
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000
          },
          "allow_reflow": {
            "type": "boolean"
          }
        },
        "required": [
          "occurrence_id",
          "copy",
          "profile_id",
          "paragraph_id",
          "section",
          "indices",
          "row",
          "col",
          "start",
          "end",
          "old_text",
          "new_text",
          "max_chars",
          "allow_reflow"
        ]
      }
    }
  },
  "required": [
    "version",
    "source_sha256",
    "plan_sha256",
    "values_sha256",
    "copies",
    "changes"
  ]
}
