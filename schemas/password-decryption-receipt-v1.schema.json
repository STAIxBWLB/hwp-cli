{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwp-cli.dev/schemas/password-decryption-receipt-v1.schema.json",
  "title": "password-decryption-receipt-v1",
  "description": "Content-free attestation of one password-decryption CLI evidence case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "source_sha256",
    "format",
    "algorithm_id",
    "credential_outcome",
    "exercised_surfaces",
    "binary_version",
    "binary_sha256",
    "result",
    "recorded_at"
  ],
  "properties": {
    "schema_version": { "const": "password-decryption-receipt-v1" },
    "fixture_id": { "$ref": "#/$defs/opaqueId" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "format": { "enum": ["hwp5", "hwpx"] },
    "algorithm_id": { "$ref": "#/$defs/identifier" },
    "kdf_id": { "$ref": "#/$defs/identifier" },
    "credential_outcome": { "enum": ["correct", "wrong", "absent"] },
    "exercised_surfaces": {
      "type": "array",
      "items": { "enum": ["cat", "convert", "render"] },
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "binary_version": { "$ref": "#/$defs/identifier" },
    "binary_sha256": { "$ref": "#/$defs/sha256" },
    "result": { "enum": ["pass", "refused"] },
    "recorded_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "opaqueId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "timestamp": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
