{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwp-cli.dev/schemas/certification-policy-v1.schema.json",
  "title": "hwp-certification-policy-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "render"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "document": { "$ref": "#/$defs/documentPolicy" },
    "render": { "$ref": "#/$defs/renderPolicy" },
    "oracle": { "$ref": "#/$defs/oraclePolicy" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "shortString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "nameSet": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/shortString" }
    },
    "countPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "max": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "namedSetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": { "$ref": "#/$defs/nameSet" },
        "required": { "$ref": "#/$defs/nameSet" }
      }
    },
    "documentPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "manifest": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "sha256"],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                  },
                  "sha256": { "$ref": "#/$defs/sha256" }
                }
              }
            },
            "allowed_requested": { "$ref": "#/$defs/nameSet" },
            "required_requested": { "$ref": "#/$defs/nameSet" },
            "forbid_substitution": { "type": "boolean" }
          }
        },
        "defined_styles": { "$ref": "#/$defs/namedSetPolicy" },
        "used_styles": { "$ref": "#/$defs/namedSetPolicy" },
        "numbering": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_definition_indexes": {
              "type": "array", "maxItems": 4096, "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0, "maximum": 65535 }
            },
            "required_definition_indexes": {
              "type": "array", "maxItems": 4096, "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0, "maximum": 65535 }
            },
            "definitions": { "$ref": "#/$defs/countPolicy" }
          }
        },
        "tables": { "$ref": "#/$defs/countPolicy" },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_schemes": {
              "type": "array", "maxItems": 64, "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z][A-Za-z0-9+.-]*$" }
            },
            "count": { "$ref": "#/$defs/countPolicy" }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_fields": { "$ref": "#/$defs/metadataFields" },
            "required_fields": { "$ref": "#/$defs/metadataFields" },
            "forbidden_fields": { "$ref": "#/$defs/metadataFields" }
          }
        },
        "macros": { "$ref": "#/$defs/presence" },
        "external_references": { "$ref": "#/$defs/presence" },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "require_picture_descriptions": { "type": "boolean" },
            "require_shape_descriptions": { "type": "boolean" }
          }
        },
        "preservation": { "$ref": "#/$defs/preservationPolicy" },
        "hancom_open": { "$ref": "#/$defs/hancomOpenPolicy" }
      }
    },
    "evidencePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "preservationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report"],
      "properties": {
        "report": { "$ref": "#/$defs/evidencePath" },
        "max_loss_codes": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "hancomOpenPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt"],
      "properties": {
        "receipt": { "$ref": "#/$defs/evidencePath" },
        "require_pass": { "type": "boolean" },
        "require_artifact_sha256": { "type": "boolean" }
      }
    },
    "metadataFields": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": ["title", "author", "subject", "keywords", "description", "last_saved_by", "create_time", "modify_time"]
      }
    },
    "presence": { "enum": ["allow", "deny", "require"] },
    "renderPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dpi": { "type": "number", "minimum": 36, "maximum": 600 },
        "pages": {
          "oneOf": [
            { "const": "all" },
            {
              "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1, "maximum": 4096 }
            }
          ]
        },
        "page_count": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exact": { "type": "integer", "minimum": 0, "maximum": 4096 },
            "min": { "type": "integer", "minimum": 0, "maximum": 4096 },
            "max": { "type": "integer", "minimum": 0, "maximum": 4096 }
          },
          "oneOf": [
            { "required": ["exact"], "not": { "anyOf": [{ "required": ["min"] }, { "required": ["max"] }] } },
            { "not": { "required": ["exact"] } }
          ]
        },
        "allowed_blank_pages": {
          "type": "array", "maxItems": 256, "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 4096 }
        },
        "fail_on_outside_page_bounds": { "type": "boolean" },
        "fail_on_potential_collision": { "type": "boolean" },
        "fail_on_unresolved_fields": { "type": "boolean" }
      }
    },
    "attestationConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "libreoffice", "extension", "image"],
      "properties": {
        "runtime": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "sha256"],
          "properties": {
            "version": { "$ref": "#/$defs/shortString" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "libreoffice": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "executable_sha256"],
          "properties": {
            "version": { "$ref": "#/$defs/shortString" },
            "executable_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "extension": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "sha256"],
          "properties": {
            "version": { "$ref": "#/$defs/shortString" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "image": {
          "type": "object", "additionalProperties": false,
          "required": ["digest"],
          "properties": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
        }
      }
    },
    "oraclePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["disabled", "optional", "required"] },
        "configuration": { "$ref": "#/$defs/attestationConfig" }
      },
      "oneOf": [
        { "properties": { "mode": { "const": "disabled" } }, "not": { "required": ["configuration"] } },
        { "properties": { "mode": { "enum": ["optional", "required"] } }, "required": ["mode", "configuration"] }
      ]
    }
  }
}
