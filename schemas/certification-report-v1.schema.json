{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwp-cli.staix.net/schemas/certification-report-v1.schema.json",
  "title": "hwp-certification-report-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "overall", "scope", "input", "policy_sha256", "checks", "render", "oracle", "artifacts", "limitations"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "contract": { "const": "hwp-certification-report-v1" },
    "overall": { "enum": ["passed", "failed", "partial"] },
    "scope": { "enum": ["native_only", "native_plus_independent_import"] },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["format", "bytes", "sha256"],
      "properties": {
        "format": { "enum": ["hwp5", "hwpx", "unknown"] },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 134217728 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "policy_sha256": { "$ref": "#/$defs/sha256" },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["package", "repeat_import_consistency", "rules"],
      "properties": {
        "package": { "$ref": "#/$defs/check" },
        "repeat_import_consistency": { "$ref": "#/$defs/check" },
        "preservation": { "$ref": "#/$defs/preservationCheck" },
        "hancom_open": { "$ref": "#/$defs/hancomOpenCheck" },
        "original_form": { "$ref": "#/$defs/originalFormCheck" },
        "rules": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "status", "observed_count", "reason_codes"],
            "properties": {
              "id": { "enum": ["defined_styles", "used_styles", "numbering.definitions", "numbering.used", "tables", "links", "metadata", "macros", "external_references", "accessibility", "unresolved_fields", "fonts"] },
              "status": { "$ref": "#/$defs/checkStatus" },
              "observed_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
              "reason_codes": { "$ref": "#/$defs/reasons" }
            },
            "oneOf": [
              { "properties": { "status": { "const": "passed" }, "reason_codes": { "maxItems": 0 } } },
              { "properties": { "status": { "const": "failed" }, "reason_codes": { "minItems": 1 } } }
            ]
          },
          "oneOf": [
            { "maxItems": 0 },
            {
              "minItems": 12, "maxItems": 12,
              "prefixItems": [
                { "properties": { "id": { "const": "defined_styles" } } },
                { "properties": { "id": { "const": "used_styles" } } },
                { "properties": { "id": { "const": "numbering.definitions" } } },
                { "properties": { "id": { "const": "numbering.used" } } },
                { "properties": { "id": { "const": "tables" } } },
                { "properties": { "id": { "const": "links" } } },
                { "properties": { "id": { "const": "metadata" } } },
                { "properties": { "id": { "const": "macros" } } },
                { "properties": { "id": { "const": "external_references" } } },
                { "properties": { "id": { "const": "accessibility" } } },
                { "properties": { "id": { "const": "unresolved_fields" } } },
                { "properties": { "id": { "const": "fonts" } } }
              ]
            }
          ]
        }
      }
    },
    "render": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "dpi", "total_pages", "selected_pages", "status", "reason_codes", "fonts", "pages", "issues", "info", "issue_count", "info_count", "issue_log_complete", "issue_sha256"],
      "properties": {
        "profile": { "const": "hwp-cli-native-certification-render-v1" },
        "dpi": { "type": "number", "minimum": 36, "maximum": 600 },
        "total_pages": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "selected_pages": {
          "type": "array", "maxItems": 256, "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 4096 }
        },
        "status": { "$ref": "#/$defs/checkStatus" },
        "reason_codes": { "$ref": "#/$defs/reasons" },
        "fonts": {
          "type": "array", "maxItems": 512,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["requested_name_sha256", "resolved_family_sha256", "font_file_sha256", "face_index", "outcome"],
            "properties": {
              "requested_name_sha256": { "$ref": "#/$defs/sha256" },
              "resolved_family_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
              "font_file_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
              "face_index": { "type": ["integer", "null"], "minimum": 0, "maximum": 4294967295 },
              "outcome": { "enum": ["matched", "substituted", "missing", "coverage_substituted"] }
            }
          }
        },
        "pages": {
          "type": "array", "maxItems": 256, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["page", "width_pt", "height_pt", "item_count", "visual_blank", "outside_page_bounds", "possible_collision", "png_sha256", "png_bytes"],
            "properties": {
              "page": { "type": "integer", "minimum": 1, "maximum": 4096 },
              "width_pt": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
              "height_pt": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
              "item_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
              "visual_blank": { "type": "boolean" },
              "outside_page_bounds": { "$ref": "#/$defs/detection" },
              "possible_collision": { "$ref": "#/$defs/detection" },
              "png_sha256": { "$ref": "#/$defs/sha256" },
              "png_bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 }
            }
          }
        },
        "issues": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/renderIssueNonInfo" }, "description": "The emitter writes one entry per issue code, so the code enum bounds the length. That bound is an emitter guarantee the schema does not enforce (uniqueItems compares whole entries), and no count cap is set because one would have to track every new code." },
        "info": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/renderIssueInfo" }, "description": "One entry per info code, bounded by the emitter the same way as issues." },
        "issue_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "info_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "issue_log_complete": { "type": "boolean" },
        "issue_sha256": { "$ref": "#/$defs/sha256" }
      },
      "oneOf": [
        { "properties": { "status": { "const": "passed" }, "reason_codes": { "maxItems": 0 } } },
        { "properties": { "status": { "enum": ["failed", "skipped"] }, "reason_codes": { "minItems": 1 } } }
      ]
    },
    "oracle": { "$ref": "#/$defs/oracleBase" },
    "artifacts": {
      "type": "array", "maxItems": 257, "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "limitations": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "prefixItems": [
        { "const": "native_not_detected_is_algorithm_scoped" },
        { "const": "hancom_rendering_parity_not_claimed" },
        { "const": "oracle_artifact_determinism_not_claimed" },
        { "const": "oracle_page_count_not_host_verified" },
        { "const": "selected_pages_only_when_policy_selects_pages" }
      ]
    }
  },
  "oneOf": [
    {
      "allOf": [
        { "$ref": "#/$defs/localPassed" },
        { "properties": { "checks": { "properties": { "original_form": { "properties": { "status": { "const": "passed" }, "limited": { "const": true } } } }, "required": ["original_form"] } } },
        {
          "properties": {
            "overall": { "const": "partial" },
            "scope": { "enum": ["native_only", "native_plus_independent_import"] },
            "oracle": { "anyOf": [{ "$ref": "#/$defs/oracleDisabledPassed" }, { "$ref": "#/$defs/oracleOptionalUnavailable" }, { "$ref": "#/$defs/oraclePassed" }] }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/localPassed" },
        {
          "properties": {
            "overall": { "const": "passed" },
            "scope": { "const": "native_only" },
            "oracle": { "$ref": "#/$defs/oracleDisabledPassed" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/localFailed" },
        {
          "properties": {
            "overall": { "const": "failed" },
            "scope": { "const": "native_only" },
            "oracle": { "$ref": "#/$defs/oracleDisabledFailed" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/localFailed" },
        {
          "properties": {
            "overall": { "const": "failed" },
            "scope": { "const": "native_only" },
            "oracle": { "$ref": "#/$defs/oracleNotRun" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/localPassed" },
        {
          "properties": {
            "overall": { "const": "passed" },
            "scope": { "const": "native_only" },
            "oracle": { "$ref": "#/$defs/oracleOptionalUnavailable" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/localPassed" },
        {
          "properties": {
            "overall": { "const": "partial" },
            "scope": { "const": "native_only" },
            "oracle": { "$ref": "#/$defs/oracleRequiredUnavailable" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/localPassed" },
        {
          "properties": {
            "overall": { "const": "partial" },
            "scope": { "const": "native_only" },
            "oracle": { "$ref": "#/$defs/oracleOptionalFailed" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/localPassed" },
        {
          "properties": {
            "overall": { "const": "failed" },
            "scope": { "const": "native_only" },
            "oracle": { "$ref": "#/$defs/oracleRequiredFailed" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/localPassed" },
        {
          "properties": {
            "overall": { "const": "passed" },
            "scope": { "const": "native_plus_independent_import" },
            "oracle": { "$ref": "#/$defs/oraclePassed" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/localPassed" },
        { "$ref": "#/$defs/evidenceFailed" },
        {
          "properties": {
            "overall": { "const": "failed" },
            "scope": { "const": "native_only" },
            "oracle": { "$ref": "#/$defs/oracleDisabledFailed" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/localPassed" },
        { "$ref": "#/$defs/evidenceFailed" },
        {
          "properties": {
            "overall": { "const": "failed" },
            "scope": { "const": "native_only" },
            "oracle": { "$ref": "#/$defs/oracleNotRun" }
          }
        }
      ]
    }
  ],
  "allOf": [
    {
      "if": { "properties": { "scope": { "const": "native_plus_independent_import" } } },
      "then": { "properties": { "artifacts": { "contains": { "properties": { "path": { "const": "oracle/import.pdf" } }, "required": ["path"] }, "minContains": 1, "maxContains": 1 } } },
      "else": { "properties": { "artifacts": { "not": { "contains": { "properties": { "path": { "const": "oracle/import.pdf" } }, "required": ["path"] } } } } }
    },
    {
      "not": {
        "allOf": [
          { "properties": { "overall": { "enum": ["passed", "partial"] } } },
          { "$ref": "#/$defs/evidenceFailed" }
        ]
      }
    },
    {
      "not": {
        "properties": {
          "overall": { "const": "passed" },
          "checks": { "properties": { "original_form": { "properties": { "limited": { "const": true } }, "required": ["limited"] } }, "required": ["original_form"] }
        },
        "required": ["overall", "checks"]
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "checkStatus": { "enum": ["passed", "failed", "skipped"] },
    "lossCount": { "type": "integer", "minimum": 1, "maximum": 1000000000, "description": "Exact sum of a code's event counts: at most 1000 events of at most 1,000,000 each." },
    "preservationLossCodes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 22,
      "properties": {
        "binary_asset_removed": { "$ref": "#/$defs/lossCount" },
        "binary_relationship_removed": { "$ref": "#/$defs/lossCount" },
        "control_metadata_unrepresentable": { "$ref": "#/$defs/lossCount" },
        "control_removed": { "$ref": "#/$defs/lossCount" },
        "document_metadata_superseded": { "$ref": "#/$defs/lossCount" },
        "document_package_passthrough_dropped": { "$ref": "#/$defs/lossCount" },
        "font_type_info_unrepresentable": { "$ref": "#/$defs/lossCount" },
        "gso_header_unrepresentable": { "$ref": "#/$defs/lossCount" },
        "gso_object_id_renumbered": { "$ref": "#/$defs/lossCount" },
        "gso_shape_unrepresentable": { "$ref": "#/$defs/lossCount" },
        "hwp_container_storage_removed": { "$ref": "#/$defs/lossCount" },
        "hwp_container_stream_removed": { "$ref": "#/$defs/lossCount" },
        "hwp_opaque_stream_changed": { "$ref": "#/$defs/lossCount" },
        "hwpx_opaque_entry_changed": { "$ref": "#/$defs/lossCount" },
        "hwpx_package_entry_removed": { "$ref": "#/$defs/lossCount" },
        "image_fill_unrepresentable": { "$ref": "#/$defs/lossCount" },
        "metadata_value_removed": { "$ref": "#/$defs/lossCount" },
        "opaque_control_unrepresentable": { "$ref": "#/$defs/lossCount" },
        "page_range_paragraph_rounded": { "$ref": "#/$defs/lossCount" },
        "paragraph_range_tag_unrepresentable": { "$ref": "#/$defs/lossCount" },
        "picture_control_removed": { "$ref": "#/$defs/lossCount" },
        "section_border_fill_ref_unresolvable": { "$ref": "#/$defs/lossCount" }
      }
    },
    "receiptShortString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "receiptTimestamp": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "preservationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_codes", "loss_code_count"],
      "properties": {
        "status": { "$ref": "#/$defs/checkStatus" },
        "reason_codes": { "$ref": "#/$defs/reasons" },
        "loss_code_count": { "type": "integer", "minimum": 0, "maximum": 1000000000, "description": "Exact sum of every event count: at most 1000 events of at most 1,000,000 each." },
        "loss_codes": { "$ref": "#/$defs/preservationLossCodes" }
      },
      "oneOf": [
        { "properties": { "status": { "const": "passed" }, "reason_codes": { "maxItems": 0 } } },
        { "properties": { "status": { "enum": ["failed", "skipped"] }, "reason_codes": { "minItems": 1 } } }
      ]
    },
    "hancomOpenCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_codes"],
      "properties": {
        "status": { "$ref": "#/$defs/checkStatus" },
        "reason_codes": { "$ref": "#/$defs/reasons" },
        "application": { "$ref": "#/$defs/receiptShortString" },
        "verified_at": { "$ref": "#/$defs/receiptTimestamp" },
        "verifier": { "$ref": "#/$defs/receiptShortString" }
      },
      "oneOf": [
        { "properties": { "status": { "const": "passed" }, "reason_codes": { "maxItems": 0 } } },
        { "properties": { "status": { "enum": ["failed", "skipped"] }, "reason_codes": { "minItems": 1 } } }
      ]
    },
    "originalFormCode": { "enum": ["output_identity_mismatch", "table_count_changed", "table_missing", "repeated_table_missing", "table_grid_changed", "expected_cell_missing", "expected_cell_value_missing", "expected_cell_value_mismatch", "expected_cell_not_rendered", "expected_cell_clipped", "form_start_missing", "form_start_ambiguous", "form_start_not_rendered", "form_start_on_wrong_page", "form_start_not_at_page_start", "table_row_clipped", "cell_fragmentation_incomplete", "disallowed_font_substitution", "original_form_document_unavailable", "original_form_plan_unreadable", "original_form_plan_not_json", "original_form_plan_contract", "original_form_plan_bounds", "original_form_plan_ids"] },
    "originalFormCheck": {
      "type": "object",
      "additionalProperties": false,
      "description": "Original-form certification (#419). Content-free: finding IDs are the plan's own stable IDs; no document or plan text appears here.",
      "required": ["status", "reason_codes", "limited", "missing_evidence", "plan_sha256", "source_sha256", "output_sha256", "expected_cell_count", "form_start_count", "findings", "findings_complete", "address_map", "address_map_published"],
      "properties": {
        "status": { "$ref": "#/$defs/checkStatus" },
        "reason_codes": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "enum": ["output_identity_mismatch", "table_count_changed", "table_missing", "repeated_table_missing", "table_grid_changed", "expected_cell_missing", "expected_cell_value_missing", "expected_cell_value_mismatch", "expected_cell_not_rendered", "expected_cell_clipped", "form_start_missing", "form_start_ambiguous", "form_start_not_rendered", "form_start_on_wrong_page", "form_start_not_at_page_start", "table_row_clipped", "cell_fragmentation_incomplete", "disallowed_font_substitution", "original_form_document_unavailable", "original_form_plan_unreadable", "original_form_plan_not_json", "original_form_plan_contract", "original_form_plan_bounds", "original_form_plan_ids", "original_form_findings_truncated"] } },
        "limited": { "type": "boolean", "description": "True when evidence named in missing_evidence was unavailable; a limited result never makes overall passed." },
        "missing_evidence": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "enum": ["render_layout_unavailable", "segment_map_truncated", "cell_render_location_unavailable", "pinned_font_environment", "parsed_document"] } },
        "plan_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "source_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "output_sha256": { "$ref": "#/$defs/sha256" },
        "expected_cell_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "form_start_count": { "type": "integer", "minimum": 0, "maximum": 256 },
        "findings": {
          "type": "array", "maxItems": 1024, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "code", "next_step"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
              "code": { "$ref": "#/$defs/originalFormCode" },
              "next_step": { "enum": ["certify_the_reviewed_output", "restore_the_form_tables_or_declare_repeats", "restore_the_original_grid", "fill_the_expected_cell", "check_pagination_and_cell_fragmentation", "restore_the_form_start", "make_the_form_start_text_unique", "restore_the_page_break_before_the_form", "shorten_the_value_or_allow_row_growth", "pin_the_requested_fonts_and_rerender", "fix_the_plan_against_its_schema", "fix_the_package_then_recertify", "check_the_plan_path_and_size", "set_the_plan_contract_and_version", "bring_the_plan_within_its_bounds", "make_plan_ids_and_cells_unique"] }
            }
          }
        },
        "findings_complete": { "type": "boolean" },
        "address_map": { "type": "boolean", "description": "The policy requested the local address map." },
        "address_map_published": { "type": "boolean", "description": "original-form/address-map.json was published; false when not requested or when the 258-file manifest cap left no room." }
      },
      "allOf": [
        { "oneOf": [
          { "properties": { "status": { "const": "passed" }, "reason_codes": { "maxItems": 0 } } },
          { "properties": { "status": { "enum": ["failed", "skipped"] }, "reason_codes": { "minItems": 1 } } }
        ] },
        { "oneOf": [
          { "properties": { "limited": { "const": false }, "missing_evidence": { "maxItems": 0 } } },
          { "properties": { "limited": { "const": true }, "missing_evidence": { "minItems": 1 } } }
        ] }
      ]
    },
    "evidenceFailed": {
      "properties": {
        "checks": {
          "anyOf": [
            { "properties": { "preservation": { "properties": { "status": { "enum": ["failed", "skipped"] } } } }, "required": ["preservation"] },
            { "properties": { "hancom_open": { "properties": { "status": { "enum": ["failed", "skipped"] } } } }, "required": ["hancom_open"] },
            { "properties": { "original_form": { "properties": { "status": { "enum": ["failed", "skipped"] } } } }, "required": ["original_form"] }
          ]
        }
      }
    },
    "reasons": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/reasonCode" } },
    "reasonCode": { "enum": ["package_validation_failed", "package_or_import_warnings", "document_parse_failed", "repeat_import_mismatch", "repeat_import_failed", "not_run", "parse_budget_exceeded", "render_policy_failed", "layout_budget_exceeded", "image_decode_budget_exceeded", "pagination_drift_detected", "font_manifest_or_resolution_failed", "render_page_scope_invalid", "render_execution_failed", "disallowed_value", "required_value_missing", "style_reference_out_of_range", "below_minimum", "above_maximum", "disallowed_definition_index", "required_definition_index_missing", "disallowed_scheme", "disallowed_field_present", "required_field_missing", "forbidden_field_present", "forbidden_present", "required_missing", "inspection_incomplete", "picture_description_missing", "shape_description_missing", "unresolved_field_binding", "requested_font_name_invalid", "disallowed_requested_font", "required_requested_font_missing", "font_or_glyph_missing", "font_substitution_forbidden", "font_resolution_report_incomplete", "resolved_font_outside_manifest", "font_resolution_not_run", "preservation_loss_detected", "preservation_report_invalid", "hancom_open_not_attested", "hancom_open_receipt_invalid"] },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason_codes", "issue_count", "issue_sha256"],
      "properties": {
        "status": { "$ref": "#/$defs/checkStatus" },
        "reason_codes": { "$ref": "#/$defs/reasons" },
        "issue_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "issue_sha256": { "$ref": "#/$defs/sha256" }
      },
      "oneOf": [
        { "properties": { "status": { "const": "passed" }, "reason_codes": { "maxItems": 0 }, "issue_count": { "const": 0 } } },
        { "properties": { "status": { "enum": ["failed", "skipped"] }, "reason_codes": { "minItems": 1 }, "issue_count": { "minimum": 1 } } }
      ]
    },
    "detection": {
      "type": "object", "additionalProperties": false, "required": ["result", "count", "algorithm", "complete"],
      "properties": {
        "result": { "enum": ["not_detected", "detected", "incomplete"] },
        "count": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "algorithm": { "enum": ["display_item_finite_bbox_vs_page_rect_v1", "cross_baseline_glyph_bbox_overlap_ge_0_25_v1"] },
        "complete": { "type": "boolean" }
      },
      "oneOf": [
        { "properties": { "result": { "const": "not_detected" }, "count": { "const": 0 }, "complete": { "const": true } } },
        { "properties": { "result": { "const": "detected" }, "count": { "minimum": 1 }, "complete": { "const": true } } },
        { "properties": { "result": { "const": "incomplete" }, "complete": { "const": false } } }
      ]
    },
    "renderIssue": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "severity", "stage", "count", "sample_sha256", "samples_complete"],
      "properties": {
        "code": { "enum": ["parse_budget_exceeded", "render_execution_failed", "pagination_drift_detected", "font_matched", "font_substituted", "font_missing", "font_manifest_load_failed", "font_resolution_budget_exceeded", "shaping_failed", "page_definition_fallback", "page_control_payload_omitted", "page_number_format_fallback", "page_number_position_omitted", "page_number_shaping_omitted", "unsupported_control_omitted", "image_size_missing_omitted", "image_data_missing_omitted", "image_decode_placeholder", "image_decode_budget_exceeded", "picture_effects_unsupported", "invalid_table_cell_omitted", "table_split_across_pages", "table_cell_fragmentation_incomplete", "table_row_too_tall_clipped", "table_cell_content_overflow", "paragraph_line_content_overflow", "text_box_geometry_invalid_omitted", "shape_depth_limit_omitted", "shape_style_invalid_omitted", "shape_geometry_invalid_omitted", "font_subset_fallback", "layout_budget_exceeded", "wmf_parse_invalid_placeholder", "wmf_unsupported_record_omitted", "wmf_budget_exceeded", "anchor_prepass_incomplete"] },
        "severity": { "enum": ["info", "warning", "incomplete", "fatal"] },
        "stage": { "enum": ["input_parse", "font_resolution", "layout", "shaping", "rasterization", "pdf_export"] },
        "count": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "sample_sha256": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "samples_complete": { "type": "boolean" }
      },
      "oneOf": [
        { "properties": { "code": { "const": "parse_budget_exceeded" }, "severity": { "const": "fatal" }, "stage": { "const": "input_parse" } } },
        { "properties": { "code": { "enum": ["render_execution_failed", "pagination_drift_detected", "layout_budget_exceeded", "wmf_budget_exceeded"] }, "severity": { "const": "fatal" }, "stage": { "const": "layout" } } },
        { "properties": { "code": { "const": "font_matched" }, "severity": { "const": "info" }, "stage": { "const": "font_resolution" } } },
        { "properties": { "code": { "const": "table_split_across_pages" }, "severity": { "const": "info" }, "stage": { "const": "layout" } } },
        { "properties": { "code": { "const": "font_substituted" }, "severity": { "const": "warning" }, "stage": { "const": "font_resolution" } } },
        { "properties": { "code": { "const": "font_missing" }, "severity": { "const": "incomplete" }, "stage": { "const": "font_resolution" } } },
        { "properties": { "code": { "const": "font_manifest_load_failed" }, "severity": { "const": "fatal" }, "stage": { "const": "font_resolution" } } },
        { "properties": { "code": { "const": "font_resolution_budget_exceeded" }, "severity": { "const": "fatal" }, "stage": { "const": "font_resolution" } } },
        { "properties": { "code": { "enum": ["shaping_failed", "page_number_shaping_omitted"] }, "severity": { "const": "incomplete" }, "stage": { "const": "shaping" } } },
        { "properties": { "code": { "enum": ["page_definition_fallback", "page_control_payload_omitted", "page_number_format_fallback", "page_number_position_omitted", "unsupported_control_omitted", "image_size_missing_omitted", "image_data_missing_omitted", "invalid_table_cell_omitted", "table_cell_fragmentation_incomplete", "table_row_too_tall_clipped", "anchor_prepass_incomplete", "text_box_geometry_invalid_omitted", "shape_depth_limit_omitted", "shape_style_invalid_omitted", "shape_geometry_invalid_omitted", "wmf_parse_invalid_placeholder", "wmf_unsupported_record_omitted"] }, "severity": { "const": "incomplete" }, "stage": { "const": "layout" } } },
        { "properties": { "code": { "const": "image_decode_placeholder" }, "severity": { "const": "incomplete" }, "stage": { "const": "rasterization" } } },
        { "properties": { "code": { "const": "picture_effects_unsupported" }, "severity": { "const": "warning" }, "stage": { "const": "layout" } } },
        { "properties": { "code": { "enum": ["table_cell_content_overflow", "paragraph_line_content_overflow"] }, "severity": { "const": "warning" }, "stage": { "const": "layout" } } },
        { "properties": { "code": { "const": "image_decode_budget_exceeded" }, "severity": { "const": "fatal" }, "stage": { "const": "rasterization" } } },
        { "properties": { "code": { "const": "font_subset_fallback" }, "severity": { "const": "warning" }, "stage": { "const": "pdf_export" } } }
      ],
      "allOf": [
        { "if": { "properties": { "samples_complete": { "const": false } } }, "then": { "properties": { "sample_sha256": { "minItems": 4 } } } }
      ]
    },
    "renderIssueNonInfo": { "allOf": [{ "$ref": "#/$defs/renderIssue" }, { "properties": { "severity": { "enum": ["warning", "incomplete", "fatal"] } } }] },
    "renderIssueInfo": { "allOf": [{ "$ref": "#/$defs/renderIssue" }, { "properties": { "code": { "enum": ["font_matched", "table_split_across_pages"] }, "severity": { "const": "info" } } }] },
    "log": {
      "type": "object", "additionalProperties": false, "required": ["bytes_observed", "bytes_hashed", "truncated", "sha256"],
      "properties": {
        "bytes_observed": { "type": "integer", "minimum": 0 },
        "bytes_hashed": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "truncated": { "type": "boolean" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256", "deterministic"],
      "properties": {
        "path": { "oneOf": [{ "type": "string", "pattern": "^pages/page-[0-9]{6}\\.png$" }, { "const": "oracle/import.pdf" }] },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "deterministic": { "type": "boolean" }
      },
      "oneOf": [
        { "properties": { "path": { "pattern": "^pages/" }, "deterministic": { "const": true } } },
        { "properties": { "path": { "const": "oracle/import.pdf" }, "deterministic": { "const": false } } }
      ]
    },
    "oracleBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "status", "reason_code", "expected", "observed", "stdout", "stderr", "artifact_determinism"],
      "properties": {
        "mode": { "enum": ["disabled", "optional", "required"] },
        "status": { "enum": ["disabled", "not_run", "passed", "failed", "oracle_unavailable"] },
        "reason_code": { "oneOf": [{ "$ref": "#/$defs/oracleReason" }, { "type": "null" }] },
        "expected": { "oneOf": [{ "$ref": "certification-oracle-result-v1.schema.json#/$defs/attestation" }, { "type": "null" }] },
        "observed": { "oneOf": [{ "$ref": "#/$defs/observedAttestation" }, { "type": "null" }] },
        "stdout": { "oneOf": [{ "$ref": "#/$defs/log" }, { "type": "null" }] },
        "stderr": { "oneOf": [{ "$ref": "#/$defs/log" }, { "type": "null" }] },
        "artifact_determinism": { "enum": ["not_applicable", "not_claimed"] }
      }
    },
    "oracleReason": { "enum": ["local_certification_failed", "policy_configuration_missing", "trusted_runner_not_configured", "oracle_process_group_unavailable_on_platform", "trusted_image_digest_mismatch", "runtime_unavailable_or_mismatched", "runtime_snapshot_not_executable", "runtime_version_probe_failed", "runtime_version_mismatch", "host_daemon_unattested", "trusted_image_attestation_invalid", "image_attestation_probe_failed", "image_attestation_mismatch", "extension_unavailable_or_mismatched", "oracle_workspace_unavailable", "oracle_input_snapshot_unavailable", "oracle_extension_snapshot_unavailable", "oracle_output_workspace_unavailable", "oracle_mount_source_invalid", "container_identity_unavailable", "container_cleanup_unverified", "runner_execution_failed", "oracle_timeout", "oracle_output_allowlist_violation", "runner_contract_missing", "runner_contract_invalid", "oracle_output_contract_mismatch", "runner_attestation_mismatch", "conversion_failed", "oracle_artifact_missing", "oracle_artifact_contract_invalid", "oracle_pdf_invalid", "oracle_artifact_copy_failed", "oracle_artifact_mismatch"] },
    "observedAttestation": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_kind", "runtime_version", "runtime_sha256", "libreoffice_version", "libreoffice_executable_sha256", "extension_version", "extension_sha256", "image_digest", "docker_client_version_sha256", "docker_server_version_sha256", "image_id", "image_reference_sha256"],
      "properties": {
        "runtime_kind": { "const": "docker" },
        "runtime_version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "runtime_sha256": { "$ref": "#/$defs/sha256" },
        "libreoffice_version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "libreoffice_executable_sha256": { "$ref": "#/$defs/sha256" },
        "extension_version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "extension_sha256": { "$ref": "#/$defs/sha256" },
        "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "docker_client_version_sha256": { "$ref": "#/$defs/sha256" },
        "docker_server_version_sha256": { "$ref": "#/$defs/sha256" },
        "image_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "image_reference_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "localPassed": {
      "properties": {
        "checks": {
          "properties": {
            "package": { "properties": { "status": { "const": "passed" } } },
            "repeat_import_consistency": { "properties": { "status": { "const": "passed" } } },
            "rules": { "minItems": 12, "maxItems": 12, "items": { "properties": { "status": { "const": "passed" } } } }
          }
        },
        "render": { "properties": { "status": { "const": "passed" } } }
      }
    },
    "localFailed": { "not": { "$ref": "#/$defs/localPassed" } },
    "oracleDisabledPassed": {
      "allOf": [
        { "$ref": "#/$defs/oracleBase" },
        { "properties": {
          "mode": { "const": "disabled" }, "status": { "const": "disabled" },
          "reason_code": { "type": "null" }, "expected": { "type": "null" },
          "observed": { "type": "null" }, "stdout": { "type": "null" },
          "stderr": { "type": "null" }, "artifact_determinism": { "const": "not_applicable" }
        } }
      ]
    },
    "oracleDisabledFailed": {
      "allOf": [
