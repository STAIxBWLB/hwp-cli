        { "properties": {
          "mode": { "enum": ["optional", "required"] }, "status": { "const": "not_run" },
          "reason_code": { "const": "local_certification_failed" },
          "expected": { "$ref": "certification-oracle-result-v1.schema.json#/$defs/attestation" },
          "observed": { "type": "null" }, "stdout": { "type": "null" },
          "stderr": { "type": "null" }, "artifact_determinism": { "const": "not_claimed" }
        } }
      ]
    },
    "oracleOptionalUnavailable": {
      "allOf": [
        { "$ref": "#/$defs/oracleUnavailable" },
        { "properties": { "mode": { "const": "optional" } } }
      ]
    },
    "oracleRequiredUnavailable": {
      "allOf": [
        { "$ref": "#/$defs/oracleUnavailable" },
        { "properties": { "mode": { "const": "required" } } }
      ]
    },
    "oracleUnavailable": {
      "allOf": [
        { "$ref": "#/$defs/oracleBase" },
        { "properties": {
          "status": { "const": "oracle_unavailable" },
          "reason_code": { "type": "string", "minLength": 1, "maxLength": 128 },
          "expected": { "$ref": "certification-oracle-result-v1.schema.json#/$defs/attestation" },
          "observed": { "type": "null" }, "stdout": { "type": "null" },
          "stderr": { "type": "null" }, "artifact_determinism": { "const": "not_claimed" }
        } }
